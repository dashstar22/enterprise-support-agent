# Runtime defaults / 运行时安全默认值
ESA_ENVIRONMENT=development
ESA_LOG_LEVEL=INFO
ESA_API_V1_PREFIX=/api/v1
ESA_BUSINESS_API_BASE_URL=http://localhost:8001

# PostgreSQL and optional model prices / PostgreSQL 和可选模型价格
# Example only: do not put a real password in source control. / 仅为示例，真实密码不要提交到版本库。
ESA_DATABASE_URL=postgresql+psycopg://esa:change-me@localhost:5432/enterprise_support
# Leave both prices empty to record Token counts without estimating money. / 两项都留空时只记录 Token，不估算金额。
ESA_MODEL_INPUT_PRICE_PER_1K=
ESA_MODEL_OUTPUT_PRICE_PER_1K=

# External services / 外部服务
# Keep disabled until a real RAGFlow instance is available. / 真实 RAGFlow 可用前保持关闭。
ESA_RAGFLOW_ENABLED=false
ESA_RAGFLOW_BASE_URL=http://localhost:9380
ESA_RAGFLOW_API_KEY=
ESA_RAGFLOW_DATASET_ID=
ESA_RAGFLOW_TIMEOUT_SECONDS=10
ESA_RAGFLOW_TOP_K=5
# Real LLM is disabled by default. When enabled, use an OpenAI-compatible /chat/completions endpoint.
# 真实大模型默认关闭；启用时填写兼容 OpenAI 的 /chat/completions 接口。
ESA_LLM_ENABLED=false
ESA_LLM_BASE_URL=https://api.openai.com/v1
ESA_LLM_MODEL=
ESA_LLM_TIMEOUT_SECONDS=30
ESA_LLM_API_KEY=
