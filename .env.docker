# Versioned local-only Docker demo configuration. / 可提交的、本地 Docker 演示配置。
# This password only protects an isolated Compose volume, not a real system. / 这只是隔离 Compose 卷的演示密码，不是真实系统密码。
POSTGRES_DB=enterprise_support
POSTGRES_USER=esa
POSTGRES_PASSWORD=esa-local-demo-only
ESA_ENVIRONMENT=development
ESA_LOG_LEVEL=INFO
ESA_RAGFLOW_ENABLED=false
